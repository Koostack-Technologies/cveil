# =============================================================================
# Operio REST API — Native Image Dockerfile
#
# Produces a statically-linked native binary via GraalVM for maximum startup
# speed (~50ms) and minimal memory footprint (~30MB RSS).  Ideal for
# serverless / scale-to-zero deployments and Kubernetes with aggressive
# HPA thresholds.
#
# Prerequisites:
#   - The Quarkus Gradle plugin must be enabled in operio-rest-api/build.gradle.kts
#     (currently commented out due to Gradle 9.x incompatibility — re-enable
#     once the Quarkus team ships a Gradle-9-compatible plugin release).
#   - Alternatively, use the Quarkus CLI: `quarkus build --native --gradle`
#     and then build only the runtime stage of this Dockerfile.
#
# Build:
#   docker build -t operio-rest-api-native -f Dockerfile.native .
#
# Run:
#   docker run -p 8080:8080 \
#     -e OPERIO_MODE=production \
#     -e OPERIO_DB_URL=jdbc:postgresql://db:5432/operio \
#     -e OPERIO_REDIS_HOST=redis \
#     -e OPERIO_PLATFORM_DB_URL=jdbc:postgresql://db:5432/operio \
#     -e OPERIO_BOOTSTRAP_KEY=opr_bootstrap_xxxxxxxxxxxx \
#     operio-rest-api-native
#
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Build the native image
# -----------------------------------------------------------------------------
FROM ghcr.io/graalvm/native-image:25 AS build

WORKDIR /app

# -- Gradle wrapper & dependency resolution (cached layer) --------------------
# Copy only build infrastructure first to maximize Docker layer cache hits.
COPY gradlew gradlew.bat settings.gradle.kts build.gradle.kts gradle.properties ./
COPY gradle/ gradle/
COPY build-logic/ build-logic/

# Copy all subproject build files for dependency resolution.
COPY operio-core/build.gradle.kts operio-core/build.gradle.kts
COPY operio-rest-api/build.gradle.kts operio-rest-api/build.gradle.kts
COPY operio-spring-boot-starter/build.gradle.kts operio-spring-boot-starter/build.gradle.kts
COPY operio-bundle-core/build.gradle.kts operio-bundle-core/build.gradle.kts
COPY operio-bundle-embedded/build.gradle.kts operio-bundle-embedded/build.gradle.kts
COPY plugins/ plugins/

# Pre-download dependencies (cached unless build files change).
RUN chmod +x gradlew && \
    ./gradlew dependencies --no-daemon -q 2>/dev/null || true

# -- Full source copy & native build ------------------------------------------
COPY . .

# Build the native image.  Key flags:
#   -Dquarkus.native.enabled=true        — trigger native-image compilation
#   -Dquarkus.native.container-build=true — use the in-container GraalVM
#                                           (no need for a local GraalVM install)
#   -Dquarkus.native.additional-build-args=--enable-preview
#                                         — required for ScopedValue (Java 25)
#
# The native binary is produced at:
#   operio-rest-api/build/*-runner
RUN chmod +x gradlew && \
    ./gradlew :operio-rest-api:build \
        -Dquarkus.native.enabled=true \
        -Dquarkus.native.container-build=true \
        "-Dquarkus.native.additional-build-args=--enable-preview" \
        --no-daemon

# -----------------------------------------------------------------------------
# Stage 2: Minimal runtime image
# -----------------------------------------------------------------------------
# quarkus-micro-image is a <10MB distroless-style image with just enough
# libc and crypto libraries to run a statically-linked Quarkus native binary.
FROM quay.io/quarkus/quarkus-micro-image:2.0

WORKDIR /app

# -- Security: run as non-root ------------------------------------------------
# The quarkus-micro-image doesn't have useradd, so we use numeric UID/GID.
# UID 1001 is the conventional non-root user for Quarkus native images.
RUN chown 1001:root /app && \
    chmod "g+rwX" /app

# -- Copy the native binary ---------------------------------------------------
COPY --from=build --chown=1001:root /app/operio-rest-api/build/*-runner /app/application

# -- Labels -------------------------------------------------------------------
LABEL org.opencontainers.image.title="Operio REST API (native)" \
      org.opencontainers.image.description="Multi-tenant consent management platform — Quarkus native image" \
      org.opencontainers.image.vendor="KooStack" \
      org.opencontainers.image.url="https://github.com/koostack/operio" \
      org.opencontainers.image.source="https://github.com/koostack/operio" \
      org.opencontainers.image.licenses="Apache-2.0"

# -- Runtime configuration ----------------------------------------------------
EXPOSE 8080

# Health check using the SmallRye Health readiness endpoint.
# Native images start in ~50ms so the start-period can be very short.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -sf http://localhost:8080/q/health/ready || exit 1

# -- Environment variable defaults --------------------------------------------
# No sensitive values baked into the image.  Override at runtime via
# `docker run -e`, docker-compose, or Kubernetes ConfigMap/Secret.
ENV QUARKUS_HTTP_HOST=0.0.0.0 \
    QUARKUS_HTTP_PORT=8080 \
    QUARKUS_VIRTUAL_THREADS_ENABLED=true \
    OPERIO_MODE=production

# Switch to non-root user
USER 1001

ENTRYPOINT ["./application"]
CMD []
