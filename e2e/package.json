{
  "name": "cveil-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end Playwright tests for Cveil",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:auth": "playwright test --grep @auth",
    "test:email": "playwright test tests/auth/email-verification.spec.ts",
    "test:consent": "playwright test --grep @consent",
    "test:governance": "playwright test --grep @governance",
    "test:catalogue": "playwright test --grep @catalogue",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^25.5.0",
    "typescript": "^5.7.0"
  }
}
