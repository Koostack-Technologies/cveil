meta {
  name: Create API Key
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/platform/api-keys
  body: json
  auth: bearer
}

auth:bearer {
  token: {{platformToken}}
}

body:json {
  {
    "tenantId": "{{tenantId}}",
    "subject": "admin-user",
    "roles": ["ADMIN_READ", "ADMIN_WRITE"]
  }
}
