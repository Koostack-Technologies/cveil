meta {
  name: Create Tenant
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/platform/tenants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{platformToken}}
}

body:json {
  {
    "tenantId": "demo_tenant",
    "displayName": "Demo Tenant",
    "plan": "free",
    "billingEmail": "admin@demo.com"
  }
}
